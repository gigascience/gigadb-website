<?php
$dbConfig = json_decode(file_get_contents(dirname(__FILE__).'/db.json'), true);
$params = array_merge(
    require __DIR__ . '/params.php',
    require __DIR__ . '/params-local.php'
);

return [
    'id' => 'GigaDB Web Site',
    'basePath' => '/var/www',
    'components' => [
        'request' => [
                'enableCsrfValidation' => false,
                'enableCookieValidation' => false,
        ],
        'db' => [
            'class' => 'yii\db\Connection',
            'dsn' => "pgsql:dbname={$dbConfig['database']};host={$dbConfig['host']}",
            'username'=>$dbConfig['user'],
            'password'=>$dbConfig['password'],
            'charset'=>'utf8',
            'enableSchemaCache' => true,
            'attributes' => [
                PDO::ATTR_PERSISTENT => true,
            ],
            'enableLogging' => true,
            'enableProfiling' => true,
        ],
        'mailer' => [
            'class' => 'yii\swiftmailer\Mailer',
            'useFileTransport' => true,
            'fileTransportPath'=>'/var/www/protected/runtime/mail',
            'transport' => [
                'class' => 'Swift_SmtpTransport',
                'encryption' => 'ssl',
                'host' => '${SERVER_EMAIL_SMTP_HOST}',
                'port' => '${SERVER_EMAIL_SMTP_PORT}',
                'username' => '${SERVER_EMAIL_USERNAME}',
                'password' => '${SERVER_EMAIL_PASSWORD}',
            ],
        ],
        'jwt' => [
            'class' => 'sizeg\jwt\Jwt',
            'key'   => $params['jwt_key'],
        ],
        'fs' => [
            'class' => 'creocoder\flysystem\LocalFilesystem',
            'path' => '@webroot/files',
        ],
        'localStore' => [
            'class' => 'creocoder\flysystem\LocalFilesystem',
            'path' => '@webroot/images',
        ],
        'cloudStore' => [
                    'class' => 'creocoder\flysystem\AwsS3Filesystem',
                    'key' => '${AWS_ACCESS_KEY_ID}',
                    'secret' => '${AWS_SECRET_ACCESS_KEY}',
                    'bucket' => 'assets.gigadb-cdn.net',
                    'region' => 'ap-east-1',
                    // 'version' => 'latest',
                    // 'baseUrl' => 'your-base-url',
                    // 'prefix' => 'your-prefix',
                    // 'options' => [],
                    // 'endpoint' => 'http://my-custom-url'
                ],
    ],
    'params' => $params,
];
?>
