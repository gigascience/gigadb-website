{
  "Version":"2012-10-17",
  "Statement":[
    {
      "Sid": "Allow gitlab-runner read/write access to the bucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::gitlab-runner/*",
        "arn:aws:s3:::gitlab-runner"
      ]
    }
  ]
}
